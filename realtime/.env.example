# Gateway Socket.IO (realtime/server.js).
# Gateway đọc file này trước, sau đó lấy các biến còn thiếu từ ../src/.env.
# Vì vậy APP_KEY, SOCKET_TOKEN_SECRET và REALTIME_INTERNAL_SECRET nên để ở src/.env
# (một nơi duy nhất) để tránh lệch secret giữa Laravel và gateway.
PORT=3001
# HOST=0.0.0.0
# Origin được phép kết nối socket (URL của app Laravel). Dùng "*" chỉ khi dev.
CORS_ORIGIN=http://localhost:8080

# Chỉ khai báo khi gateway chạy tách biệt, không đọc được ../src/.env.
# Giá trị phải giống hệt bên Laravel (src/.env).
# APP_KEY=
# SOCKET_TOKEN_SECRET=
# REALTIME_INTERNAL_SECRET=
