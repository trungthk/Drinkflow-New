APP_NAME=DrinkFlow
APP_ENV=local
APP_KEY=
# Khi đổi APP_KEY: đưa key cũ vào đây (phân tách bằng dấu phẩy) để vẫn giải mã được dữ liệu đã mã hóa.
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_DATE_FORMAT="d/m/Y"
APP_DATETIME_FORMAT="d/m/Y H:i:s"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drinkflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Realtime gateway (realtime/server.js)
# REALTIME_URL: địa chỉ nội bộ Laravel gọi tới gateway; REALTIME_PUBLIC_URL: địa chỉ trình duyệt kết nối.
REALTIME_URL=http://127.0.0.1:3001
REALTIME_PUBLIC_URL=http://localhost:3001
REALTIME_INTERNAL_SECRET=change-this-in-production
# Để trống để dùng APP_KEY. Gateway tự đọc các giá trị này từ file src/.env.
SOCKET_TOKEN_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chỉ cần khi FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAINS=company.com

# Food crawler (bỏ trống để dùng đường dẫn mặc định theo hệ điều hành)
# FOOD_CRAWLER_CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# FOOD_CRAWLER_NODE_BINARY="C:\Program Files\nodejs\node.exe"
# FOOD_CRAWLER_NPM_BINARY="C:\Program Files\nodejs\npm.cmd"
FOOD_CRAWLER_BROWSER_TIMEOUT=30
# Đặt false để thấy trình duyệt khi chẩn đoán. Không dùng Chrome profile đang mở.
FOOD_CRAWLER_HEADLESS=true
# FOOD_CRAWLER_USER_DATA_DIR="C:\Users\YourUser\AppData\Local\Google\Chrome\User Data"
# FOOD_CRAWLER_PROFILE_DIRECTORY=Default
FOOD_CRAWLER_DIAGNOSTICS_PATH="storage/logs/food-crawler-browser.json"

# Giám sát queue worker qua Supervisor (chỉ bật trên server có supervisorctl)
SUPERVISOR_ENABLED=false
SUPERVISOR_PROGRAM=
SUPERVISORCTL_PATH=/usr/bin/supervisorctl

# Số ngày giữ dữ liệu trước khi dọn dẹp tự động
RETENTION_AUDIT_LOGS_DAYS=30
RETENTION_CRAWLER_PREVIEWS_DAYS=2
RETENTION_LOG_FILES_DAYS=14
RETENTION_READ_ADMIN_NOTIFICATIONS_DAYS=30
RETENTION_READ_USER_NOTIFICATIONS_DAYS=30
