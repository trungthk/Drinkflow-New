# Biến cho docker-compose.yml (tùy chọn). Dự án chạy mặc định KHÔNG dùng Docker;
# cấu hình Laravel nằm ở src/.env.example, cấu hình gateway realtime ở realtime/.env.example.
POSTGRES_DB=drinkflow
POSTGRES_USER=drinkflow
POSTGRES_PASSWORD=change-this-in-production
# Để trống để dùng APP_KEY của Laravel.
SOCKET_TOKEN_SECRET=
REALTIME_INTERNAL_SECRET=change-this-in-production
CORS_ORIGIN=http://localhost:8080
